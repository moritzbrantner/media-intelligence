# Core ports
MOCK_SERVICE_PORT=8080
MOCK_INGESTION_PORT=8081
MOCK_TRANSCRIPTION_PORT=8082
MOCK_OCR_PORT=8083
MOCK_ENRICHMENT_PORT=8084
MOCK_PROFILING_PORT=8085
MOCK_INDEXER_PORT=8086
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Core service credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Service runtime connections
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_RAW_BUCKET=raw-media
MINIO_PROCESSED_BUCKET=processed
MINIO_FRAMES_BUCKET=frames
ELASTICSEARCH_URL=http://elasticsearch:9200

# Elastic stack tuning
ELASTIC_VERSION=8.12.0
ES_JAVA_OPTS="-Xms1g -Xmx1g"
